#include <dt-bindings/zmk/matrix_transform.h>

/ {
	chosen {
		zephyr,display = &oled;
		zmk,kscan = &kscan0;
		zmk,matrix_transform = &default_transform;
	};

	kscan0: kscan {
		compatible = "zmk,kscan-gpio-matrix";
		wakeup-source;

		diode-direction = "col2row";
	};

	/*
	 * steps = pulses per FULL ROTATION, which replaced the deprecated
	 * "resolution" (pulses per detent, which was 4 here). These are not the
	 * same units, so this is a conversion rather than a rename:
	 *
	 *   20 detents x 4 quadrature pulses = 80 pulses per rotation
	 *
	 * The result is identical to the old behaviour. In steps mode the driver
	 * reports degrees, so one detent is (4 * 360) / 80 = 18 degrees, and ZMK
	 * fires a behavior every 360 / CONFIG_ZMK_KEYMAP_SENSORS_DEFAULT_TRIGGERS_
	 * PER_ROTATION = 360 / 20 = 18 degrees. One detent, one trigger, as before.
	 *
	 * If these encoders turn out not to have 20 detents, override
	 * triggers-per-rotation on the sensors node rather than fiddling with
	 * steps -- steps describes the hardware, triggers-per-rotation describes
	 * how often you want the keymap to fire.
	 */
	left_encoder: encoder_left {
		compatible = "alps,ec11";
		steps = <80>;
		status = "disabled";
	};

	right_encoder: encoder_right {
		compatible = "alps,ec11";
		steps = <80>;
		status = "disabled";
	};

	sensors {
		compatible = "zmk,keymap-sensors";
		sensors = <&left_encoder &right_encoder>;
	};

	// TODO: RGB node(s)
};

&pro_micro_i2c {
	status = "okay";

	oled: ssd1306@3c {
		compatible = "solomon,ssd1306fb";
		reg = <0x3c>;
		width = <128>;
		height = <64>;
		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <63>;
		prechargep = <0x22>;
		inversion-on;
	};
};

/*
 * The on/off switch for the reactive underglow, implemented in
 * src/klor_rgb_behavior.c. It lives here rather than in the keymap's behaviors
 * block because it must exist on BOTH halves: the behavior is global-locality,
 * so the central forwards it over the split link and the peripheral resolves it
 * by name. A node defined only on the central would leave the right half's
 * strip stuck on.
 *
 * The binding comes from dts/bindings/behaviors/klor,behavior-rgb.yaml, found
 * because zephyr/module.yml sets dts_root.
 */
/ {
	behaviors {
		rgb: klor_rgb_control {
			compatible = "klor,behavior-rgb";
			#binding-cells = <1>;
			display-name = "Underglow";
		};
	};
};
